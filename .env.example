# Local LLM server (optional — these are the defaults used by src/extract.py).
# Set them as environment variables to use another OpenAI-compatible server,
# e.g. Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5vl
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen2.5-vl-7b

# Only needed for Layer 2 (Google Sheet export). Copy to .env and fill in.
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials.json
GOOGLE_SHEET_ID=
